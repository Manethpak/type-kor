      "id": "home-row",
      "order": 1,
      "title": {
        "km": "ជួរគោល",
        "en": "Home row"
      },
      "description": {
        "km": "ស្គាល់គ្រាប់ចុចមូលដ្ឋាន និងចលនាម្រាមដៃខ្លីៗ។",
        "en": "Learn the anchor keys and short finger movements."
      }
    },
    {
      "schemaVersion": 1,
      "id": "consonants",
      "order": 2,
      "title": {
        "km": "ព្យញ្ជនៈ",
        "en": "Consonants"
      },
      "description": {
        "km": "បន្ថែមព្យញ្ជនៈធម្មតា និងគ្រាប់ចុច Shift។",
        "en": "Add common consonants and the Shift layer."
      }
    },
    {
      "schemaVersion": 1,
      "id": "vowels",
      "order": 3,
      "title": {
        "km": "ស្រៈ និងសញ្ញា",
        "en": "Vowels and marks"
      },
      "description": {
        "km": "បង្កើតចង្កោមជាមួយស្រៈលើ ក្រោម មុខ និងក្រោយ។",
        "en": "Build clusters with vowels above, below, before, and after."
      }
    },
    {
      "schemaVersion": 1,
      "id": "clusters",
      "order": 4,
      "title": {
        "km": "ជើងអក្សរ",
        "en": "Subscript clusters"
      },
      "description": {
        "km": "រៀនគ្រាប់ចុច ្ និងលំដាប់បង្កើតចង្កោមខ្មែរ។",
        "en": "Learn the coeng key and Khmer cluster order."
      }
    },
    {
      "schemaVersion": 1,
      "id": "words",
      "order": 5,
      "title": {
        "km": "ពាក្យ និងឃ្លា",
