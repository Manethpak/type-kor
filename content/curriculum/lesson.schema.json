{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typekor.local/schemas/curriculum-lesson.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "unitId",
    "order",
    "title",
    "description",
    "masteryAccuracy",
    "steps"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "unitId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "masteryAccuracy": { "type": "integer", "minimum": 1, "maximum": 100 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "oneOf": [{ "$ref": "#/$defs/typingStep" }, { "$ref": "#/$defs/keyStep" }] }
    }
  },
  "$defs": {
    "stepId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "typingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "kind": { "const": "typing" },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "keyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "kind": { "const": "key" },
        "label": { "$ref": "#/$defs/localizedText" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "layer"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "layer": { "enum": ["base", "shift", "altGr"] }
          }
        }
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["km"],
      "properties": {
        "km": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
