{
  "name": "typekor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lesson:gen": "node scripts/generate-curriculum.mjs",
    "lesson:check": "node scripts/generate-curriculum.mjs --check",
    "words:fetch": "node scripts/fetch-word-lists.mjs",
    "predev": "pnpm lesson:gen",
    "dev": "vite",
    "prebuild": "pnpm lesson:gen",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fmt": "oxfmt fmt ./src",
    "fmt:check": "oxfmt fmt --check ./",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretypecheck": "pnpm lesson:gen",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "react": "latest",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "latest",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "ajv": "^8.20.0",
    "jsdom": "latest",
    "oxfmt": "^0.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.34.1"
}
